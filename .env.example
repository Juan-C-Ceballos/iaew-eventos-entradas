# Variables de entorno de referencia — completar cuando se defina el stack tecnológico.
# No commitear nunca este archivo con valores reales (usar .env, ya ignorado por git).

# --- Auth0 / Authorization Server ---
# AUTH0_DOMAIN=
# AUTH0_AUDIENCE=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# --- API key adicional (endpoint protegido con x-api-key) ---
# API_KEY=

# --- Base de datos ---
# DATABASE_URL=

# --- Broker de mensajes (RabbitMQ/Kafka/SQS/EventBridge) ---
# BROKER_URL=
