# Variables de entorno de referencia. Copiar a .env (ignorado por git) y completar.
# Nunca commitear valores reales. Docker Compose usa estos mismos nombres y
# reemplaza los hosts (localhost -> nombre del servicio) dentro de la red de Compose.

# --- API ---
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/iaew_eventos

# --- Auth0 (Resource Server) ---
AUTH0_DOMAIN=tu-tenant.us.auth0.com
AUTH0_AUDIENCE=https://iaew-eventos-api
# Credenciales del cliente Machine to Machine: solo para pedir tokens (curl/Postman).
# La API no las usa. Completar únicamente en .env.
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# --- Endpoint interno protegido con x-api-key (comparación, no reemplaza OAuth) ---
INTERNAL_API_KEY=colocar-api-key-local

# --- RabbitMQ ---
RABBIT_URL=amqp://iaew:iaew-local@localhost:5672
RABBIT_USER=iaew
RABBIT_PASS=iaew-local
RETRY_DELAY_MS=3000
MAX_RETRIES=3
# Cada cuánto el relay del outbox publica los entrada.comprada pendientes
OUTBOX_INTERVALO_MS=1000

# --- Pasarela de pago simulada y webhook ---
PAGOS_URL=http://localhost:4000
WEBHOOK_URL=http://localhost:3000/webhooks/pagos
WEBHOOK_SECRET=colocar-secreto-compartido-local
WEBHOOK_TOLERANCIA_SEGUNDOS=300

# --- Reglas de negocio ---
RESERVA_TTL_MINUTOS=15
